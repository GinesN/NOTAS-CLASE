# Optional settings. The server reads process variables, not this file.
# Without AULA_LOCAL_MODE=1 or --local, the app uses password authentication.
AULA_HOST=127.0.0.1
AULA_PORT=4173
# AULA_DATA_DIR=/absolute/persistent/path/aula
# AULA_PUBLIC_URL=https://your-domain.example
# Outlook and English email briefs: see docs/portal.md.
# AULA_MS_TENANT_ID=consumers
# AULA_MS_CLIENT_ID=
# AULA_MS_CLIENT_SECRET=
# AULA_AI_API_KEY=
# AULA_AI_MODEL=gpt-4.1-mini
